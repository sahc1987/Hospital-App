# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# PostgreSQL
POSTGRES_DB=hms_db
POSTGRES_USER=hms_user
POSTGRES_PASSWORD=change_me_strong_password

# Redis
REDIS_PASSWORD=change_me_redis_password

# JWT (use a 256-bit+ random string in production)
JWT_SECRET=change-me-in-production-use-at-least-256-bit-random-key
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Frontend
VITE_API_URL=http://localhost:8080

# Hospital time zone: "today", working hours and booking times are evaluated here
TZ=America/New_York
